# Copy to .env for local development. Never commit real values.
APP_ENV=development
PORT=3100
LOG_LEVEL=info

# Local services from infra/docker/docker-compose.yml
DATABASE_URL=postgres://mawjood:mawjood@localhost:5442/mawjood
REDIS_URL=redis://localhost:6389
SMTP_URL=smtp://localhost:1035
EMAIL_FROM="MAWJOOd <no-reply@mawjood.local>"

# Required in staging/production (>= 32 random characters). Dev uses an insecure built-in default.
APP_SECRET=
# ES256 key pair (PEM, PKCS#8 private / SPKI public). Dev generates an ephemeral pair if empty.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Comma-separated origins allowed by CORS (admin web). Mobile apps are not subject to CORS.
CORS_ORIGINS=
DEFAULT_TIMEZONE=Africa/Casablanca
DEFAULT_CURRENCY=MAD
MAX_ACTIVE_RESERVATIONS=3

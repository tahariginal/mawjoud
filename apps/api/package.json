{
  "name": "@mawjood/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "concurrently -k -n tsc,api,worker \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch-path=dist --env-file-if-exists=.env dist/main.js\" \"node --watch-path=dist --env-file-if-exists=.env dist/worker.js\"",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "db:migrate": "node --env-file-if-exists=.env dist/database/cli.js migrate",
    "db:rollback": "node --env-file-if-exists=.env dist/database/cli.js rollback",
    "db:seed": "node --env-file-if-exists=.env dist/database/cli.js seed",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@mawjood/contracts": "workspace:*",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/throttler": "6.7.1",
    "argon2": "0.45.1",
    "bullmq": "6.3.11",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "jose": "6.2.12",
    "kysely": "0.29.6",
    "nestjs-pino": "5.2.1",
    "nodemailer": "10.0.13",
    "pg": "8.23.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/testing": "12.1.2",
    "@swc/core": "1.16.13",
    "@testcontainers/postgresql": "12.2.0",
    "@testcontainers/redis": "12.2.0",
    "@types/express": "5.0.6",
    "@types/node": "^24",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "concurrently": "10.0.5",
    "eslint": "9.39.5",
    "pino-pretty": "13.1.3",
    "supertest": "7.3.0",
    "testcontainers": "12.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.0",
    "unplugin-swc": "2.0.0",
    "vitest": "4.1.11"
  }
}

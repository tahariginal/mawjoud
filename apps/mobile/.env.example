# Copy to .env.local for local development. Never commit real values.

# development | staging | production
EXPO_PUBLIC_APP_ENV=development

# demo  = isolated in-memory demo adapter (development only; refused in production)
# http  = real MAWJOOd API at EXPO_PUBLIC_API_BASE_URL
EXPO_PUBLIC_API_MODE=demo
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Build-time only (read by app.config.ts). Restrict the key to the app's package + signing cert.
GOOGLE_MAPS_ANDROID_API_KEY=

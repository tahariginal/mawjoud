{
  "name": "mazal",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "verify": "turbo run lint typecheck test build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "services:up": "docker compose -f infra/docker/docker-compose.yml up -d --wait",
    "services:down": "docker compose -f infra/docker/docker-compose.yml down",
    "services:reset": "docker compose -f infra/docker/docker-compose.yml down -v"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "turbo": "2.11.6"
  }
}
